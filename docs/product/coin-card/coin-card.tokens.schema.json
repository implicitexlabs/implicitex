{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://implicitex.com/schemas/coin-card.tokens.v1.schema.json",
  "title": "ImplicitEx Coin Card Tokens V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "schemaVersion",
    "status",
    "date",
    "units",
    "boxSizing",
    "tolerance",
    "constants",
    "assets",
    "formFactors",
    "typography",
    "overflow",
    "ratios"
  ],
  "properties": {
    "name": { "const": "implicitex.coin-card.tokens.v1" },
    "schemaVersion": { "const": "coin-card.tokens.v1" },
    "status": { "const": "normative" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "units": { "const": "css_px" },
    "boxSizing": { "const": "border-box" },
    "tolerance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "renderedCssPx"],
      "properties": {
        "token": { "const": 0 },
        "renderedCssPx": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "constants": {
      "type": "object",
      "required": ["expanded", "collapsed"]
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lettermark", "implicitexWordmark", "coinCardWordmark"],
      "properties": {
        "lettermark": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "viewBox",
            "aspectRatio",
            "preserveAspectRatio",
            "allowedScaleRatio"
          ],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "viewBox": {
              "type": "array",
              "prefixItems": [
                { "type": "number" },
                { "type": "number" },
                { "type": "number" },
                { "type": "number" }
              ],
              "minItems": 4,
              "maxItems": 4
            },
            "aspectRatio": { "const": 1 },
            "preserveAspectRatio": { "const": "xMidYMid meet" },
            "allowedScaleRatio": { "const": 1 }
          }
        },
        "implicitexWordmark": { "$ref": "#/$defs/brandAsset" },
        "coinCardWordmark": { "$ref": "#/$defs/brandAsset" }
      }
    },
    "formFactors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collapsedAcceptanceMark", "expandedHorizontal"],
      "properties": {
        "collapsedAcceptanceMark": { "$ref": "#/$defs/collapsedAcceptanceMark" },
        "expandedHorizontal": { "$ref": "#/$defs/expandedHorizontal" }
      }
    },
    "typography": { "type": "object" },
    "overflow": { "type": "object" },
    "ratios": { "type": "object" }
  },
  "$defs": {
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number" },
        "height": { "type": "number" }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "slotBox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "baseline": { "type": "number" }
      }
    },
    "divider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x1", "y1", "x2", "y2"],
      "properties": {
        "x1": { "type": "number" },
        "y1": { "type": "number" },
        "x2": { "type": "number" },
        "y2": { "type": "number" }
      }
    },
    "brandAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "viewBox", "role"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "viewBox": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4
        },
        "role": {
          "enum": ["canonical-brand-wordmark", "canonical-product-wordmark"]
        }
      }
    },
    "collapsedAcceptanceMark": {
      "type": "object",
      "required": ["outer", "grid", "slots", "lettermark"],
      "properties": {
        "outer": { "$ref": "#/$defs/box" },
        "grid": { "type": "object" },
        "slots": { "type": "object" },
        "lettermark": { "type": "object" }
      }
    },
    "expandedHorizontal": {
      "type": "object",
      "required": ["outer", "planes", "slots", "inset", "border", "radius", "lettermark"],
      "properties": {
        "outer": { "$ref": "#/$defs/box" },
        "planes": { "type": "object" },
        "slots": { "type": "object" },
        "inset": { "$ref": "#/$defs/point" },
        "border": { "type": "object" },
        "radius": { "type": "number" },
        "lettermark": { "type": "object" }
      }
    }
  }
}
