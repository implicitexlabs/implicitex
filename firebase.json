{
  "hosting": [
    {
      "target": "main",
      "public": "app-web/frontend/public",
      "predeploy": [
        "npm --prefix app-web run predeploy:coin-card",
        "node docs/blockaid-review-packet/build-public-page.js",
        "git diff --exit-code app-web/frontend/public/architecture-and-security.html"
      ],
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/card/**",
          "destination": "/card/index.html"
        }
      ],
      "redirects": [
        {
          "source": "/get-started.html",
          "destination": "/start.html",
          "type": 301
        },
        {
          "source": "/verification.html",
          "destination": "/verify.html",
          "type": 301
        },
        {
          "source": "/trust.html",
          "destination": "/verify.html",
          "type": 301
        }
      ],
      "headers": [
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.css",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, must-revalidate"
            }
          ]
        },
        {
          "source": "/v1-execution.html",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        },
        {
          "source": "/downloads/implicitex-v1-execution-plan-rev6.pdf",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            },
            {
              "key": "Content-Disposition",
              "value": "attachment; filename=\"implicitex-v1-execution-plan-rev6.pdf\""
            },
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        },
        {
          "source": "/downloads/implicitex-comprehensive-roadmap-2026-07-30.pdf",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            },
            {
              "key": "Content-Disposition",
              "value": "attachment; filename=\"implicitex-comprehensive-roadmap-2026-07-30.pdf\""
            },
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://gasstation.polygon.technology https://polygon-bor-rpc.publicnode.com https://rpc-amoy.polygon.technology; object-src 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=(), payment=()"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "Content-Security-Policy",
              "value": "frame-ancestors 'none'"
            }
          ]
        },
        {
          "source": "/verify.html",
          "headers": [
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "Content-Security-Policy",
              "value": "frame-ancestors 'none'"
            }
          ]
        },
        {
          "source": "/card/**",
          "headers": [
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors *"
            }
          ]
        }
      ]
    },
    {
      "target": "coincard",
      "public": "coincard/public",
      "predeploy": [
        "npm --prefix app-web run predeploy:coincard-public"
      ],
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "claim/**",
        "send/**",
        "js/claim.js",
        "css/claim-theme.css",
        "css/coincard.css",
        "components/images/coincard-logo.svg",
        "components/images/lettermark-white.svg",
        "components/images/wordmark-white.svg"
      ],
      "redirects": [
        {
          "source": "/claim{,/**}",
          "destination": "/",
          "type": 302
        },
        {
          "source": "/send{,/**}",
          "destination": "/",
          "type": 302
        }
      ],
      "headers": [
        {
          "source": "/.well-known/coin-card-public-username-registry-head.v1.json",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json; charset=utf-8"
            },
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            },
            {
              "key": "Cross-Origin-Resource-Policy",
              "value": "cross-origin"
            },
            {
              "key": "Cache-Control",
              "value": "no-store, max-age=0"
            },
            {
              "key": "CDN-Cache-Control",
              "value": "no-store"
            },
            {
              "key": "Surrogate-Control",
              "value": "no-store"
            }
          ]
        },
        {
          "source": "/.well-known/coin-card-public-username-registry-snapshots/sha256/**",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json; charset=utf-8"
            },
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            },
            {
              "key": "Cross-Origin-Resource-Policy",
              "value": "cross-origin"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, s-maxage=31536000, immutable"
            },
            {
              "key": "CDN-Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, must-revalidate"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://coincard.click https://*.googleapis.com https://*.firebaseio.com; object-src 'none'; base-uri 'self'; form-action 'self'"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            }
          ]
        }
      ]
    },
    {
      "target": "portal",
      "public": "app-web/frontend/public",
      "predeploy": [
        "npm --prefix app-web run predeploy:portal"
      ],
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "index.html"
      ],
      "rewrites": [
        {
          "source": "/",
          "destination": "/portal-index.html"
        },
        {
          "source": "/card/**",
          "destination": "/card/index.html"
        }
      ],
      "headers": [
        {
          "source": "/build-info.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.css",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, must-revalidate"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://gasstation.polygon.technology https://polygon-bor-rpc.publicnode.com https://rpc-amoy.polygon.technology; object-src 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=(), payment=()"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            }
          ]
        },
        {
          "source": "/card/**",
          "headers": [
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors *"
            }
          ]
        }
      ]
    }
  ]
}
