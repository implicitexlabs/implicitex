# IX ID Public Edge — Cloud Run service
# =======================================
# Credential-less public boundary. No Firestore role.
# Proxies GET /public/identity/{ix_id} to the private ixid-projection service
# using an OIDC identity token from the GCE metadata server.
#
# Authentication: publicly invokable (allUsers → roles/run.invoker).
# The runtime identity (ixid-edge-runtime) holds only service-scoped
# roles/run.invoker on ixid-projection — no Firestore/Datastore permissions.
#
# Build:
#   docker build -f Dockerfile.edge -t ixid-public-edge .

FROM python:3.13-slim

RUN adduser --disabled-password --gecos "" appuser

WORKDIR /app

# Edge only needs Flask and Gunicorn; no Firestore client.
RUN pip install --no-cache-dir flask==3.1.3 gunicorn==26.0.0 \
    werkzeug==3.1.8 blinker==1.9.0 click==8.4.2 \
    itsdangerous==2.2.0 jinja2==3.1.6 markupsafe==3.0.3

COPY ixid_edge_handler.py .

USER appuser

ENV PORT=8080
EXPOSE 8080

CMD ["sh", "-c", "exec gunicorn --bind 0.0.0.0:${PORT} --workers 1 --threads 8 --timeout 30 ixid_edge_handler:app"]
