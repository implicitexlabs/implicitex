      "fundMovingWriteAllowed": false
    },
    {
      "id": "recovery",
      "ownedBy": "transaction",
      "question": "What prevented completion, and what can the sender do next?",
      "fundMovingWriteAllowed": false
    }
  ],
  "testableAssertions": [
    "Every ownership edge points to one natural owner.",
    "No forbidden dependency edge is present in the implementation mapping.",
    "Coin Card owns identity, transaction, and receipt.",
    "Coin Card owns verified transfer intent but not execution fulfillment.",
    "Transfer Portal augments Coin Card but does not route Coin Card payments.",
    "IX_EXECUTION owns execution fulfillment, wallet, approval, transfer, receipt polling, and fee math.",
    "Identity regions are structural and persist across workflow states.",
    "Workflow regions may change across workflow states.",
    "A confirmed transfer terminates inside the Coin Card.",
    "Screenshots are never treated as structural authority."
  ]
