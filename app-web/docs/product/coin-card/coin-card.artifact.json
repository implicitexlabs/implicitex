  "regionModel": {
    "identity": {
      "role": "structural",
      "stateControlled": false,
      "mustPersistAcrossWorkflowStates": true,
      "examples": [
        "issuer",
        "verification status",
        "recipient identity",
        "network and token rail",
        "product or issuer branding"
      ]
    },
    "transaction": {
      "role": "stateful",
      "stateControlled": true,
      "mayChangeAcrossWorkflowStates": true,
      "examples": [
        "amount entry",
        "wallet connection",
        "network switch",
        "approval",
        "transfer execution",
        "error recovery"
      ]
    },
    "receipt": {
      "role": "terminal-evidence",
      "stateControlled": true,
      "mustTerminateConfirmedTransfer": true,
      "examples": [
        "transaction hash",
        "confirmed amount",
        "confirmed fee",
        "explorer link",
        "receipt or proof packet"
      ]
    }
  },
  "invariants": [
    {
      "id": "complete-payment-instrument",
      "rule": "Every payment must be completable without leaving the Coin Card."
    },
    {
      "id": "portal-optional",
      "rule": "The Transfer Portal is optional and must never become a required payment step."
    },
    {
      "id": "direct-execution-engine",
      "rule": "Coin Card and Transfer Portal consume IX_EXECUTION independently; neither routes through the other."
    },
    {
      "id": "execution-request-boundary",
      "rule": "Coin Card creates a verified transfer intent. IX_EXECUTION fulfills it through a product-level execution request."
    },
    {
      "id": "single-execution-owner",
      "rule": "IX_EXECUTION owns wallet access, approval, transfer, receipt polling, and fee math."
    },
    {
      "id": "single-fee-authority",
      "rule": "IX_EXECUTION.calculateFee() is the single fee authority for Coin Card and Transfer Portal."
    },
    {
      "id": "identity-regions-are-structural",
      "rule": "Identity regions are structural. Workflow regions are stateful. Structural regions never disappear. Workflow regions may change."
    },
    {
      "id": "receipt-stays-in-instrument",
      "rule": "A confirmed transfer must terminate in a Coin Card receipt or confirmation state."
    }
  ],
  "expectedLifecycle": [
    {
      "id": "identity-loaded",
      "ownedBy": "identity",
      "question": "Who can I pay here?",
      "fundMovingWriteAllowed": false
    },
    {
      "id": "amount-ready",
