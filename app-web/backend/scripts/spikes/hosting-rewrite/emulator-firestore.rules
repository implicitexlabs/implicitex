// Firestore security rules for the hosting-rewrite spike emulator.
//
// These rules are permissive to allow the seed script (which uses the Admin SDK
// in an emulator context) to write fixtures and the verify script to read
// spike_invocations. The Admin SDK bypasses these rules; they only affect
// direct client-SDK access, which this spike does not use.
//
// DO NOT use these rules in any production or staging Firebase project.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow full access within the emulator so seed + verify scripts work
    // without needing authentication setup.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
